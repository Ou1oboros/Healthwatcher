{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "System.Net.Http.HttpClient": "Warning"
        }
    },
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=healthwatcher.db"
    },
    "Monitoring": {
        "IntervalSeconds": 30,
        "TimeoutSeconds": 10,
        "MaxConcurrentChecks": 10,
        "Targets": [
            "https://www.google.com",
            "https://github.com",
            "https://www.nic.gov.sa",
            "https://httpstat.us/503"
        ]
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:4200" ]
    },
    "AllowedHosts": "*"
}
